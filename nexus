function F.createBullet(p12, p13)
	local magnitude3 = (p12 - p13).Magnitude
	if magnitude3 < 1 then return end
	local v14 = (p12 + p13) / 2
	local Part3 = Instance.new("Part")
	Part3.Name = "RayPart"
	Part3:SetAttribute("NexusSA", true)
	Part3.Material = Enum.Material.Neon
	Part3.Anchored = true
	Part3.Transparency = 0.5
	Part3.Size = Vector3.new(0.1, 0.1, magnitude3)
	Part3.CFrame = CFrame.new(v14, p13)
	Part3.CanCollide = false
	Part3.CanQuery = false
	Part3.CanTouch = false
	Part3.BrickColor = BrickColor.Yellow()
	game:GetService("Debris"):AddItem(Part3, 0.08)
	Part3.Parent = workspace.CurrentCamera
end

function F.rollSilentMiss()
	if not S.silentAim then
		S.silentNextIsMiss = false
		return false
	end
	local now = tick()
	if now - (S.silentMissRollAt or 0) > 0.04 then
		S.silentMissRollAt = now
		local pct = tonumber(S.silentMissPct) or 0
		S.silentNextIsMiss = pct > 0 and (math.random() * 100) < pct
	end
	return S.silentNextIsMiss == true
end

function F.silentAimHasTarget()
	if S.wallbang and F.getWallbangHitPart() then return true end
	if S.silentAim ~= true then return false end
	if F.rollSilentMiss() then return false end
	return F.getSilentAimHitPart() ~= nil
end

pcall(function()
	local mod = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("GunTracers"))
