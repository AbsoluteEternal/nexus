function F.getScreenBox(char)
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not head or not root then return nil end

	local vp = Camera.ViewportSize
	local function project(worldPos)
		local v, on = Camera:WorldToViewportPoint(worldPos)

		if not on or v.Z <= 0 then return nil end
		if v.X < 0 or v.Y < 0 or v.X > vp.X or v.Y > vp.Y then return nil end
		return Vector2.new(v.X, v.Y), v.Z
	end

	local top = project(head.Position + Vector3.new(0, 0.8, 0))
	local bot = project(root.Position - Vector3.new(0, 3.0, 0))
	local mid = project(root.Position)
	if not top or not bot or not mid then return nil end

	local height = math.abs(bot.Y - top.Y)
	if height < 10 or height > vp.Y * 0.8 then return nil end

	local width = math.clamp(height * 0.5, 10, vp.X * 0.35)
	local cx = mid.X
	local minX, maxX = cx - width * 0.5, cx + width * 0.5
	local minY, maxY = math.min(top.Y, bot.Y), math.max(top.Y, bot.Y)
	return minX, minY, maxX, maxY
end

function F.restoreChamsVisual(data)
	if not data or not data.chamsOrig then return end
	for inst, props in pairs(data.chamsOrig) do
		if inst and inst.Parent then
			pcall(function()
				for k, v in pairs(props) do
					inst[k] = v
				end
			end)
		end
	end
	data.chamsOrig = nil
	data.chamsChar = nil
	data.chamsColor = nil
end

function F.applySolidChams(player, char, data, col)

	if data.chamsChar == char and data.chamsColor == col and data.chamsOrig then
		return
	end

	if data.chamsChar and data.chamsChar ~= char then
		F.restoreChamsVisual(data)
	end
	if not data.chamsOrig then data.chamsOrig = {} end
	local orig = data.chamsOrig
	local function save(inst, keys)
		if orig[inst] then return end
		local t = {}
		for _, k in ipairs(keys) do
			pcall(function() t[k] = inst[k] end)
		end
		orig[inst] = t
	end

	for _, inst in ipairs(char:GetChildren()) do
		if inst:IsA("BasePart") then
			save(inst, {"Color", "Material", "Transparency", "Reflectance"})
			pcall(function()
				inst.Material = Enum.Material.ForceField
				inst.Color = col
				inst.Transparency = 0
				inst.Reflectance = 0
			end)
		elseif inst:IsA("Shirt") then
			save(inst, {"ShirtTemplate"})
			pcall(function() inst.ShirtTemplate = "" end)
		elseif inst:IsA("Pants") then
			save(inst, {"PantsTemplate"})
			pcall(function() inst.PantsTemplate = "" end)
		elseif inst:IsA("ShirtGraphic") then
			save(inst, {"Graphic"})
			pcall(function() inst.Graphic = "" end)
		elseif inst:IsA("Accessory") then
			local handle = inst:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				save(handle, {"Transparency", "LocalTransparencyModifier"})
				pcall(function()
					handle.Transparency = 1
					handle.LocalTransparencyModifier = 1
				end)
			end
		end
	end

	for _, inst in ipairs(char:GetDescendants()) do
		if inst:IsA("BasePart") and inst.Parent ~= char then

			if inst.Name ~= "Handle" and not orig[inst] then
				save(inst, {"Color", "Material", "Transparency", "Reflectance"})
				pcall(function()
					inst.Material = Enum.Material.ForceField
					inst.Color = col
					inst.Transparency = 0
					inst.Reflectance = 0
				end)
			end
		elseif inst:IsA("Decal") or inst:IsA("Texture") then
			if not orig[inst] then
				save(inst, {"Transparency"})
				pcall(function() inst.Transparency = 1 end)
			end
		end
	end
	data.chamsChar = char
	data.chamsColor = col
end

function F.updateChamsColorOnly(data, col)
	if not data or not data.chamsOrig or data.chamsColor == col then return end
	for inst in pairs(data.chamsOrig) do
		if inst and inst.Parent and inst:IsA("BasePart") and inst.Name ~= "Handle" then
			pcall(function() inst.Color = col end)
		end
	end
	data.chamsColor = col
end

function F.createOrUpdateHighlight(player)
	local char = player.Character
	if not char then return end
	if IS_PAID and S.espRangeOn and F.getPlayerDistance(player) > (S.espMaxRange or 1000) then
		local data = highlightObjects[player]
		if data then
			F.restoreChamsVisual(data)
			if data.Highlight then data.Highlight:Destroy() end
			if data.Billboard then data.Billboard:Destroy() end
			highlightObjects[player] = nil
		end
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not head then return end
	local data = highlightObjects[player] or {}
	highlightObjects[player] = data
	if data.Highlight and data.Highlight.Parent ~= char then data.Highlight:Destroy(); data.Highlight = nil end
	if data.Billboard and data.Billboard.Parent ~= char then data.Billboard:Destroy(); data.Billboard = nil end
	local col = F.getESPColor(player)
	local hl = data.Highlight
	if S.espChams then
		if not hl or not hl.Parent then
			hl = Instance.new("Highlight")
			hl.DepthMode = HIGHLIGHT_DEPTH
			hl.Parent = char
			data.Highlight = hl
		end
		hl.FillColor = col
		hl.OutlineColor = col
		hl.FillTransparency = 0.15
		hl.OutlineTransparency = 0
		hl.Enabled = true
		if data.chamsChar ~= char or not data.chamsOrig then
			F.applySolidChams(player, char, data, col)
		else
			F.updateChamsColorOnly(data, col)
		end
	else
		if hl then hl.Enabled = false end
		if data.chamsOrig then
			F.restoreChamsVisual(data)
		end
	end
	if S.espNames or S.espDistance then
		local bill = data.Billboard
		if not bill or not bill.Parent then
			bill = Instance.new("BillboardGui")
			bill.AlwaysOnTop = true
			bill.Size = UDim2.new(0, 140, 0, 36)
			bill.StudsOffset = Vector3.new(0, 3.2, 0)
			bill.Adornee = head
			bill.Parent = char
			data.Billboard = bill
			local nl = Instance.new("TextLabel")
			nl.Name = "NameLabel"; nl.Size = UDim2.new(1, 0, 0, 16); nl.BackgroundTransparency = 1
			nl.TextStrokeTransparency = 0.25; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13; nl.Text = player.Name; nl.Parent = bill
			local dl = Instance.new("TextLabel")
			dl.Name = "DistLabel"; dl.Size = UDim2.new(1, 0, 0, 14); dl.Position = UDim2.new(0, 0, 0, 16)
			dl.BackgroundTransparency = 1; dl.TextStrokeTransparency = 0.3; dl.Font = Enum.Font.Code; dl.TextSize = 11
			dl.TextColor3 = Color3.fromRGB(200, 200, 210); dl.Parent = bill
		else
			bill.Adornee = head
		end
		local nl = data.Billboard:FindFirstChild("NameLabel")
		local dl = data.Billboard:FindFirstChild("DistLabel")
		if nl then nl.Visible = S.espNames; nl.Text = player.Name; nl.TextColor3 = col end
		if dl then
			dl.Visible = S.espDistance
			if S.espDistance then
				local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				dl.Text = (myRoot and root) and (math.floor((root.Position - myRoot.Position).Magnitude) .. " studs") or "? studs"
			end
		end
	elseif data.Billboard then
		data.Billboard:Destroy(); data.Billboard = nil
	end
end

function F.updateESPDrawings()
	if not S.highlights or not hasDrawing then F.clearTracers(); return end
	local vp = Camera.ViewportSize
	local bottomCenter = Vector2.new(vp.X * 0.5, vp.Y - 2)
	local active = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and F.isAlive(plr) then
			local outOfRange = IS_PAID and S.espRangeOn and F.getPlayerDistance(plr) > (S.espMaxRange or 1000)
			if not outOfRange then
				local char = plr.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local minX, minY, maxX, maxY = F.getScreenBox(char)
				if minX then
					active[plr] = true
					local pack = F.ensureDrawPack(plr)
					local col = F.getESPColor(plr)

					if S.espBoxes then
						pack.box = pack.box or {}
						for i = 1, 4 do
							pack.box[i] = pack.box[i] or F.drawingNew("Line")
						end
						local tl, tr = Vector2.new(minX, minY), Vector2.new(maxX, minY)
						local bl, br = Vector2.new(minX, maxY), Vector2.new(maxX, maxY)
						F.setLine(pack.box[1], tl, tr, col, 1.6)
						F.setLine(pack.box[2], tr, br, col, 1.6)
						F.setLine(pack.box[3], br, bl, col, 1.6)
						F.setLine(pack.box[4], bl, tl, col, 1.6)
					elseif pack.box then
						for _, ln in pairs(pack.box) do if ln then ln.Visible = false end end
					end

					if S.espHealth and hum then
						local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						local barX = minX - 6
						local top, bot = Vector2.new(barX, minY), Vector2.new(barX, maxY)
						local filledY = maxY - (maxY - minY) * pct
						pack.hpBg = pack.hpBg or F.drawingNew("Line")
						pack.hpFg = pack.hpFg or F.drawingNew("Line")
						F.setLine(pack.hpBg, top, bot, Color3.fromRGB(30, 30, 30), 3)
						local hpCol = pct > 0.5 and Color3.fromRGB(80, 255, 120) or pct > 0.25 and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(255, 70, 70)
						F.setLine(pack.hpFg, Vector2.new(barX, filledY), bot, hpCol, 3)
					else
						if pack.hpBg then pack.hpBg.Visible = false end
						if pack.hpFg then pack.hpFg.Visible = false end
					end

					if S.espTracers then
						local to = Vector2.new((minX + maxX) * 0.5, maxY)
						pack.tracer = pack.tracer or F.drawingNew("Line")
						F.setLine(pack.tracer, bottomCenter, to, col, 1.4)
					elseif pack.tracer then
						pack.tracer.Visible = false
					end
				end
			end
		end
	end
	for plr, pack in pairs(tracerDrawings) do
		if not active[plr] then

			F.destroyDrawing(pack)
			tracerDrawings[plr] = nil
		end
	end
end

function F.updateTracers()
	F.updateESPDrawings()
