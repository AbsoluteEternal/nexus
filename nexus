function F.onNexusUserDetected(plr)
	if not plr or plr == LocalPlayer or nexusNotified[plr.UserId] then return end
	nexusNotified[plr.UserId] = true
	F.rememberNexusUser(plr)
	if UI.notify then UI.notify("Nexus User", plr.Name .. " is using Nexus V2") end
	if UI.refreshAdminList then pcall(UI.refreshAdminList) end
end
function F.characterHasNexus(char)
	if not char then return false end
	local ok, val = pcall(function() return char:GetAttribute(NEXUS_ATTR) end)
	return ok and val == true
end
function F.watchCharacter(plr, char)
	if not char or plr == LocalPlayer then return end
	if F.characterHasNexus(char) then F.onNexusUserDetected(plr) end
	pcall(function()
		char:GetAttributeChangedSignal(NEXUS_ATTR):Connect(function()
			if F.characterHasNexus(char) then F.onNexusUserDetected(plr) end
		end)
	end)
end
function F.setupNexusWatch(plr)
	if plr == LocalPlayer then return end
	plr.CharacterAdded:Connect(function(char) task.defer(function() F.watchCharacter(plr, char) end) end)
	if plr.Character then F.watchCharacter(plr, plr.Character) end
end
