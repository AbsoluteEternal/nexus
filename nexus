function F.pushKillfeedMessage(killer, victim)
	if not IS_PAID or not S.killfeedUI then return end
	F.ensureKillfeedGui()

	local kName = F.resolveDisplayName(killer)
	local vName = F.resolveDisplayName(victim)
	if kName == "" then kName = "?" end
	if vName == "" then vName = "?" end

	while #killfeedRows >= KILLFEED_MAX do
		local old = table.remove(killfeedRows, 1)
		if old then pcall(function() old:Destroy() end) end
	end

	local kCol = F.teamColorForName(killer or kName)
	local vCol = F.teamColorForName(victim or vName)

	local pad = 10
	local gap = 6
	local kW = math.max(28, #kName * 7 + 6)
	local midW = 48
	local vW = math.max(28, #vName * 7 + 6)
	local totalW = pad * 2 + kW + gap + midW + gap + vW

	local row = Instance.new("Frame")
	row.Size = UDim2.new(0, totalW, 0, 26)
	row.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
	row.BackgroundTransparency = 0.25
	row.BorderSizePixel = 0
	row.Parent = killfeedList
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(40, 40, 44)
	stroke.Transparency = 0.4
	stroke.Parent = row

	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal
	lay.VerticalAlignment = Enum.VerticalAlignment.Center
	lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lay.Padding = UDim.new(0, gap)
	lay.Parent = row
	local padObj = Instance.new("UIPadding")
	padObj.PaddingLeft = UDim.new(0, pad)
	padObj.PaddingRight = UDim.new(0, pad)
	padObj.Parent = row

	local function nameLabel(text, color, width)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0, width, 1, 0)
		l.BackgroundTransparency = 1
		l.Text = text
		l.TextColor3 = color
		l.Font = Enum.Font.GothamBold
		l.TextSize = 12
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.TextTruncate = Enum.TextTruncate.None
		l.Parent = row
		return l
	end
	nameLabel(kName, kCol, kW)
	local mid = Instance.new("TextLabel")
	mid.Size = UDim2.new(0, midW, 1, 0)
	mid.BackgroundTransparency = 1
	mid.Text = "killed"
	mid.TextColor3 = Color3.fromRGB(160, 160, 165)
	mid.Font = Enum.Font.Gotham
	mid.TextSize = 11
	mid.Parent = row
	nameLabel(vName, vCol, vW)

	table.insert(killfeedRows, row)
	row.BackgroundTransparency = 1
	for _, c in ipairs(row:GetDescendants()) do
		if c:IsA("TextLabel") then c.TextTransparency = 1 end
	end
	task.spawn(function()
		for i = 1, 8 do
			local t = 1 - i / 8
			row.BackgroundTransparency = 0.25 + t * 0.75
			for _, c in ipairs(row:GetDescendants()) do
				if c:IsA("TextLabel") then c.TextTransparency = t end
			end
			task.wait(0.02)
		end
		row.BackgroundTransparency = 0.25
		for _, c in ipairs(row:GetDescendants()) do
			if c:IsA("TextLabel") then c.TextTransparency = 0 end
		end
	end)
	task.delay(8, function()
		if not row.Parent then return end
		for i = #killfeedRows, 1, -1 do
			if killfeedRows[i] == row then table.remove(killfeedRows, i) break end
		end
		pcall(function() row:Destroy() end)
	end)
end

task.spawn(function()
	local folder = ReplicatedStorage:FindFirstChild("Killfeed") or ReplicatedStorage:WaitForChild("Killfeed", 30)
	if not folder then warn("[Nexus] Killfeed not found"); return end
	folder.ChildAdded:Connect(function(entry)
		task.defer(function()
			task.wait(0.05)
			if F.killfeedEntryIsMine(entry) then F.playKillSound() end
			if S.killfeedUI then
				local killer, victim = F.parseKillfeedEntry(entry)
				if killer or victim then
					F.pushKillfeedMessage(killer, victim)
				end
			end
		end)
	end)
end)

