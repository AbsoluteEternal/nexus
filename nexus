		nl.Parent = box
		local vl = Instance.new("TextLabel")
		vl.Size = UDim2.new(0.4, 0, 0, 12)
		vl.Position = UDim2.new(0.6, 0, 0, 0)
		vl.BackgroundTransparency = 1
		vl.Text = tostring(def)
		vl.TextColor3 = Theme.Accent
		vl.Font = Enum.Font.Code
		vl.TextSize = 11
		vl.TextXAlignment = Enum.TextXAlignment.Right
		vl.Parent = box
		table.insert(themedElements, {obj = vl, prop = "TextColor3", key = "Accent"})
		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, 0, 0, 3)
		track.Position = UDim2.new(0, 0, 0, 18)
		track.BackgroundColor3 = Theme.Track
		track.BorderSizePixel = 0
		track.Parent = box
		table.insert(themedElements, {obj = track, prop = "BackgroundColor3", key = "Track"})
		local pct = (def - minV) / (maxV - minV)
		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(pct, 0, 1, 0)
		fill.BackgroundColor3 = Theme.Accent
		fill.BorderSizePixel = 0
		fill.Parent = track
		table.insert(themedElements, {obj = fill, prop = "BackgroundColor3", key = "Accent"})
		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 8, 0, 8)
		knob.Position = UDim2.new(pct, -4, 0.5, -4)
		knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
		knob.BorderSizePixel = 0
		knob.ZIndex = 2
		knob.Parent = track
		local sliding = false
		local function upd(v)
			v = math.clamp(math.floor(v + 0.5), minV, maxV)
			local p = (v - minV) / (maxV - minV)
			fill.Size, knob.Position, vl.Text = UDim2.new(p, 0, 1, 0), UDim2.new(p, -4, 0.5, -4), tostring(v)
			cb(v)
		end
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				upd(minV + math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (maxV - minV))
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				upd(minV + math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (maxV - minV))
			end
		end)
	end

