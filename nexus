function F.extractShotOrigin(t, depth)
	if type(t) ~= "table" or (depth or 0) > 8 then return nil end
	local v1, v2 = rawget(t, 1), rawget(t, 2)
	if F.isVec(v1) and F.isVec(v2) then
		return F.toVector3(v1)
	end
	for _, v in pairs(t) do
		if type(v) == "table" then
			local o = F.extractShotOrigin(v, (depth or 0) + 1)
			if o then return o end
		end
	end
	return nil
end

function F.deepCopy(t, depth)
	if type(t) ~= "table" or (depth or 0) > 10 then return t end
	local n = {}
	for k, v in pairs(t) do
		n[k] = type(v) == "table" and F.deepCopy(v, (depth or 0) + 1) or v
	end
	return n
end

function F.patchWallbangTable(t, hrp, depth)
	if type(t) ~= "table" or depth > 8 or not hrp then return false end
	local did = false
	local v1, v2, v3 = rawget(t, 1), rawget(t, 2), rawget(t, 3)

	if F.isVec(v1) and F.isVec(v2) then
		rawset(t, 2, F.makeShotVector(hrp.Position))
		rawset(t, 3, hrp)
		did = true
	elseif typeof(v3) == "Instance" or v3 == nil then
		rawset(t, 3, hrp)
		if F.isVec(v2) then
			rawset(t, 2, F.makeShotVector(hrp.Position))
		end
		did = true
	end
	for _, v in pairs(t) do
		if type(v) == "table" then
			if F.patchWallbangTable(v, hrp, depth + 1) then
				did = true
			end
		end
	end
	return did
end

function F.patchShotTable(t, hitPart, originPos, depth)
	if type(t) ~= "table" or depth > 8 or not hitPart then return false end
	local did = false
	local v1, v2, v3 = rawget(t, 1), rawget(t, 2), rawget(t, 3)

	if F.isVec(v1) and F.isVec(v2) then
		if originPos then
			rawset(t, 1, F.makeShotVector(originPos))
		end
		rawset(t, 2, F.makeShotVector(hitPart.Position))
		if typeof(v3) == "Instance" or v3 == nil then
			rawset(t, 3, hitPart)
		end
		did = true
	elseif F.isVec(v2) and typeof(v3) == "Instance" then
		if originPos and F.isVec(v1) then
			rawset(t, 1, F.makeShotVector(originPos))
		end
		rawset(t, 2, F.makeShotVector(hitPart.Position))
		rawset(t, 3, hitPart)
		did = true
	end
	for _, v in pairs(t) do
		if type(v) == "table" then
			if F.patchShotTable(v, hitPart, originPos, depth + 1) then
				did = true
			end
		end
	end
	return did
end

function F.findHeadHitInArgs(args)
	local foundPlr = nil
	local function scan(t, depth)
		if type(t) ~= "table" or depth > 8 then return end
		local v3 = rawget(t, 3)
		if typeof(v3) == "Instance" and v3:IsA("BasePart") and v3.Name == "Head" then
			local model = v3.Parent
			if model then
				local plr = Players:GetPlayerFromCharacter(model)
				if plr and plr ~= LocalPlayer then foundPlr = plr end
			end
		end
		for _, v in pairs(t) do
			if type(v) == "table" then scan(v, depth + 1) end
		end
	end
	for i = 1, #args do
		if type(args[i]) == "table" then scan(args[i], 0) end
	end
	return foundPlr
end

do
	if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
		local wrap = (type(newcclosure) == "function") and newcclosure or function(f) return f end
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
			local method = getnamecallmethod()
			if method ~= "FireServer" then
				return oldNamecall(self, ...)
			end

			local fromUs = false
			if type(checkcaller) == "function" then
				local ok, r = pcall(checkcaller)
				fromUs = ok and r == true
			end
			if fromUs then
				return oldNamecall(self, ...)
			end

			local okN, nm = pcall(function() return self.Name end)
			if not okN or nm ~= "ShootEvent" then
				return oldNamecall(self, ...)
			end

			S.lastShotAt = tick()

			local nArgs = select("#", ...)
			local original = table.create(nArgs)
			for i = 1, nArgs do
				original[i] = select(i, ...)
			end

			local function fireOriginal()
				if type(setnamecallmethod) == "function" then
					pcall(setnamecallmethod, "FireServer")
				end
				return oldNamecall(self, unpack(original, 1, nArgs))
			end

			if S.wallbang then
				local hrp = F.getWallbangHitPart()
				if hrp and hrp.Parent then
					local patchedArgs = table.create(nArgs)
					local didPatch = false
					for i = 1, nArgs do
						local a = original[i]
						if type(a) == "table" then
							local copy = F.deepCopy(a, 0)
							pcall(F.patchWallbangTable, copy, hrp, 0)
							patchedArgs[i] = copy
							didPatch = true
						else
							patchedArgs[i] = a
						end
					end
					if didPatch then
						hideClientRayUntil = tick() + 0.15
						pcall(F.wipeUntaggedRays)
						local origin = F.getGunMuzzlePos()
						for i = 1, nArgs do
							if type(original[i]) == "table" then
								local o = F.extractShotOrigin(original[i], 0)
								if o then origin = o break end
							end
						end
						task.defer(function()
							F.wipeUntaggedRays()
							F.showGunBulletTracer(origin, hrp.Position)
						end)
						if type(setnamecallmethod) == "function" then
							pcall(setnamecallmethod, "FireServer")
						end
						return oldNamecall(self, unpack(patchedArgs, 1, nArgs))
					end
				end
			elseif S.silentAim then
				if F.rollSilentMiss() then
					return fireOriginal()
				end
				local hitPart = F.getSilentAimHitPart()
				if hitPart and hitPart.Parent then
					local muzzle = F.getGunMuzzlePos()
					local patchedArgs = table.create(nArgs)
					local didPatch = false
					for i = 1, nArgs do
						local a = original[i]
						if type(a) == "table" then
							local copy = F.deepCopy(a, 0)
							pcall(F.patchShotTable, copy, hitPart, nil, 0)
							patchedArgs[i] = copy
							didPatch = true
						else
							patchedArgs[i] = a
						end
					end
					if didPatch then
						pcall(function()
							if S.silentTarget and hitPart.Name == "Head" then
								F.markHeadShotAttempt(S.silentTarget)
							end
						end)
						hideClientRayUntil = tick() + 0.15
						pcall(F.wipeUntaggedRays)
						local hitPos = hitPart.Position
						task.defer(function()
							F.wipeUntaggedRays()
							F.showGunBulletTracer(muzzle, hitPos)
						end)
						if type(setnamecallmethod) == "function" then
							pcall(setnamecallmethod, "FireServer")
						end
						return oldNamecall(self, unpack(patchedArgs, 1, nArgs))
					end
				end
			end

			pcall(function()
				local headPlr = F.findHeadHitInArgs(original)
				if headPlr then F.markHeadShotAttempt(headPlr) end
			end)
			return fireOriginal()
		end))
	else
		warn("[Nexus] Silent aim needs hookmetamethod")
	end
end

