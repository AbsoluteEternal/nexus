	local function createSlider(parent, name, minV, maxV, def, cb)
		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 30)
		box.BackgroundTransparency = 1
		box.Parent = parent
		registerSearch(box, name, guessSearchTab(box))
		local nl = Instance.new("TextLabel")
		nl.Size = UDim2.new(0.55, 0, 0, 12)
		nl.BackgroundTransparency = 1
