	local function registerSearch(obj, text, tab)
		if not obj then return end
		table.insert(searchableItems, {
			obj = obj,
			text = string.lower(tostring(text or "")),
			tab = tab,
		})
	end
	local function runSearch(query)
		local q = string.lower((query or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		local tabHits = { Home = 0, Commands = 0, ESP = 0, Settings = 0, Tutorial = 0, Admin = 0 }
		local matched = table.create(#searchableItems)

		for i, item in ipairs(searchableItems) do
			local show = (q == "" or (item.text ~= "" and string.find(item.text, q, 1, true) ~= nil))
			matched[i] = show
		end

		for i, item in ipairs(searchableItems) do
			if not matched[i] and item.obj then
				for j, other in ipairs(searchableItems) do
					if matched[j] and other.obj and other.obj ~= item.obj then
						local ok, isDesc = pcall(function() return other.obj:IsDescendantOf(item.obj) end)
						if ok and isDesc then
							matched[i] = true
							break
						end
					end
				end
			end
		end
		for i, item in ipairs(searchableItems) do
			if item.obj and item.obj.Parent then
				item.obj.Visible = matched[i] and true or false
				if matched[i] and item.tab and tabHits[item.tab] ~= nil then
					tabHits[item.tab] = tabHits[item.tab] + 1
				end
			end
		end
		if q ~= "" then
			local bestTab, bestN = nil, 0
			for tab, n in pairs(tabHits) do
				if n > bestN then bestTab, bestN = tab, n end
			end
			if bestTab and bestN > 0 and UI.setActiveTab then
				UI.setActiveTab(bestTab)
			end
		end
	end

