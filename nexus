		local function layoutTracer(color)
			local stageAbs = stage.AbsoluteSize
			if stageAbs.X < 4 or stageAbs.Y < 4 then return end
			local from = Vector2.new(stageAbs.X * 0.5, stageAbs.Y - 4)
			local to = Vector2.new(stageAbs.X * 0.5, stageAbs.Y * 0.55 + 45)
			local delta = to - from
			local len = delta.Magnitude
			local ang = math.deg(math.atan2(delta.Y, delta.X)) - 90
			tracerPrev.Size = UDim2.new(0, 2, 0, math.max(len, 2))
			tracerPrev.Position = UDim2.new(0, from.X, 0, from.Y)
			tracerPrev.Rotation = ang
