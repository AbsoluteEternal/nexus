function F.getTriggerbotHitPart()
	if S.silentAim then
		local part = F.getSilentAimHitPart()
		if part and F.hasLineOfSight(part) then return part end
	end
	local maxR = (IS_PAID and S.silentRangeOn) and S.silentMaxRange or nil
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end
	local best, bestD, bestPart = nil, math.huge, nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and F.isAlive(plr) and F.matchesAimTarget(plr) and plr.Character then
			local head = plr.Character:FindFirstChild("Head")
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			if head and root and F.isInFovCircle(head.Position) then
				local part = head
				if IS_PAID and S.legit then
					part = F.getAimPart(plr.Character) or head
				end
				if part and F.hasLineOfSight(part) then
					local d = (root.Position - myRoot.Position).Magnitude
					if not (maxR and d > maxR) and d < bestD then
						bestD, best, bestPart = d, plr, part
					end
				end
			end
		end
	end
	return bestPart
end

