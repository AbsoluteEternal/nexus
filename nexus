function F.getMP5Table()
	local ok, tbl = pcall(function()
		local folder = ReplicatedStorage:FindFirstChild("SharedModules")
		folder = folder and folder:FindFirstChild("ToolProperties")
		local mod = folder and folder:FindFirstChild("MP5")
		if not mod then return nil end
