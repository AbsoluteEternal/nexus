					local net = stats:FindFirstChild("Network")
					local item = net and net:FindFirstChild("ServerStatsItem")
					local data = item and item:FindFirstChild("Data Ping")
					if data then ping = math.floor(data:GetValue()) end
				end)
				if not ping then
