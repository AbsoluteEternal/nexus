RunService.RenderStepped:Connect(function()
	if S.fovCircle and UI.FovCircle then
		local m = F.getMouseScreenPos()
		UI.FovCircle.Position = UDim2.fromOffset(m.X, m.Y)
	end
	if not S.freecam then
		if S.cameraLock then F.refreshTargetList(); if UI.updateSpectateLabel then UI.updateSpectateLabel() end end
		if S.cameraLock and #targetList > 0 then
			local t = targetList[S.targetIndex]
			if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
				Camera.CameraType = Enum.CameraType.Scriptable
				local pos = t.Character.HumanoidRootPart.Position
				Camera.CFrame = CFrame.lookAt(pos + Vector3.new(0, 4, 12), pos + Vector3.new(0, 1.5, 0))
			else F.refreshTargetList() end
		elseif S.aimlock then
			Camera.CameraType = Enum.CameraType.Custom
			local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then Camera.CameraSubject = h end
			local c = F.getClosestPlayer(true, S.fovCircle)
			if c and c.Character then
				local part = F.getAimPart(c.Character)
				if part then
					Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, part.Position), 1 / math.max(S.aimSmooth, 1))
				end
			end
		else
			F.returnToOwnCamera()
		end
	end
	F.updateSilentAimHighlight()
	if S.highlights then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				F.createOrUpdateHighlight(p)
			end
		end
		for p in pairs(highlightObjects) do
			if p == LocalPlayer or not p.Parent or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
				F.cleanupPlayer(p)
			end
		end
		F.updateTracers()
	else
		F.clearTracers()
	end
end)

