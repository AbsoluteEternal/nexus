end

function F.simulateMouseClick()

	if type(mouse1click) == "function" then
		mouse1click()
		return true, "mouse1click"
	end
	if type(mouse1press) == "function" then
		mouse1press()
		if type(mouse1release) == "function" then
			task.delay(0.03, function()
				pcall(mouse1release)
			end)
		end
		return true, "mouse1press"
	end
	local okVim, vim = pcall(function()
		return game:GetService("VirtualInputManager")
	end)
	if okVim and vim then
		local pos = UserInputService:GetMouseLocation()
		vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
		task.delay(0.03, function()
			pcall(function()
				vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
			end)
		end)
		return true, "VirtualInputManager"
	end
	return false, "no mouse click API found"
end

function F.tryTriggerbot()
	if not S.triggerbot then return end
	if not S.minimized then return end
	if UI.MainFrame and UI.MainFrame.Visible then return end
	if not F.hasGunEquipped() then return end
	local hitPart = F.getTriggerbotHitPart()
	if not hitPart then return end
	if not F.hasLineOfSight(hitPart) then return end
	local now = tick()
	if now - (S.lastTriggerShot or 0) < 0.004 then return end
	S.lastTriggerShot = now

	local okCall, success, method = pcall(F.simulateMouseClick)
	if not okCall then
		F.triggerDiag("error: " .. tostring(success))
		return
	end
	if success then
		if now - triggerDiagT > 3 then
			triggerDiagT = now
			print("[Nexus Triggerbot] click via " .. tostring(method))
		end
	else
		F.triggerDiag("failed: " .. tostring(method))
	end
end

