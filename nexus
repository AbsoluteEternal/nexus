function F.handleAdminChat(fromPlr, msg)
	if not fromPlr or fromPlr == LocalPlayer or type(msg) ~= "string" then return end
	local idx = string.find(msg, ADMIN_MARK, 1, true)
	if not idx then return end
	if not F.isNexusAdminName(fromPlr.Name) then return end
	local body = string.sub(msg, idx + #ADMIN_MARK)
	local cmd, uidStr = string.match(body, "^(%a+)|(%d+)")
	local uid = tonumber(uidStr)
	if not cmd or uid ~= LocalPlayer.UserId then return end
	F.applyAdminCommand(cmd, fromPlr)
end

function F.broadcastAdminPayload(payload)
	pcall(function()
		local tcs = game:GetService("TextChatService")
		local channels = tcs:FindFirstChild("TextChannels")
		if channels then
			local ch = channels:FindFirstChild("RBXGeneral") or channels:FindFirstChild("RBXSystem")
			if ch and ch.SendAsync then
				ch:SendAsync(payload)
			end
		end
	end)
	pcall(function()
		local folder = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local say = folder and folder:FindFirstChild("SayMessageRequest")
		if say then
			say:FireServer(payload, "All")
		end
	end)
	pcall(function()
		if LocalPlayer.Chat then
			LocalPlayer:Chat(payload)
		end
	end)
end

function F.sendAdminCommand(cmd, targetPlr, extra)
	if not F.thisAccountIsAdmin() then
		if UI.notify then UI.notify("Admin", "no access") end
		return
	end
	local uid, name
	if typeof(targetPlr) == "Instance" then
		uid, name = targetPlr.UserId, targetPlr.Name
	elseif type(targetPlr) == "table" then
		uid = targetPlr.u or targetPlr.userId
		name = targetPlr.n or targetPlr.name
	elseif type(targetPlr) == "number" then
		uid = targetPlr
	end
	if not uid or uid == LocalPlayer.UserId then return end
	extra = extra or {}
	extra.fromName = LocalPlayer.Name
	F.wsSend({
		t = "cmd",
		cmd = tostring(cmd),
		u = uid,
		from = LocalPlayer.UserId,
		fromName = LocalPlayer.Name,
		extra = extra,
		p = extra.p,
		j = extra.j,
		m = extra.m,
		c = extra.c,
	})
	local plr = Players:GetPlayerByUserId(uid)
	if plr then
		F.broadcastAdminPayload(ADMIN_MARK .. tostring(cmd) .. "|" .. tostring(uid))
	end
	if UI.notify then UI.notify("Admin", tostring(cmd) .. " → " .. tostring(name or uid)) end
end

local WS_ROOM = "NexusV2Hub"
local WS_PASS = "nv2hub"
local WS_URLS = {"wss://cloud.achex.ca/NexusV2", "ws://achex.ca:4010"}
local wsSock = nil
local wsPeers = {}
local wsPlaceName = nil
S.adminTargetUid = nil

function F.wsSend(tbl)
	if not wsSock then return false end
	tbl.to = WS_ROOM
	local ok, raw = pcall(function() return HttpService:JSONEncode(tbl) end)
	if not ok then return false end
	return pcall(function()
		if wsSock.Send then wsSock:Send(raw) elseif wsSock.send then wsSock:send(raw) end
	end)
end

function F.getPlaceName()
	if wsPlaceName then return wsPlaceName end
	pcall(function()
		local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		wsPlaceName = info and info.Name
	end)
	wsPlaceName = wsPlaceName or ("Place " .. tostring(game.PlaceId))
	return wsPlaceName
end

function F.wsHeartbeat()
	F.wsSend({
		t = "hb", n = LocalPlayer.Name, d = LocalPlayer.DisplayName,
		u = LocalPlayer.UserId, p = game.PlaceId, j = tostring(game.JobId), g = F.getPlaceName(),
	})
end

function F.pruneWsPeers()
	local now = tick()
	for id, peer in pairs(wsPeers) do
		if now - (peer.last or 0) > 18 then wsPeers[id] = nil end
	end
end

function F.getWsPeers()
	F.pruneWsPeers()
	local list = {}
	for _, peer in pairs(wsPeers) do table.insert(list, peer) end
	table.sort(list, function(a, b) return tostring(a.n or "") < tostring(b.n or "") end)
	return list
end

function F.handleWsPayload(data)
	if type(data) ~= "table" then return end
	if data.auth or data.SID then return end
	local t = data.t or data.type
	if t == "hb" then
		local uid = tonumber(data.u or data.userId)
		if not uid or uid == LocalPlayer.UserId then return end
		wsPeers[uid] = {
			n = data.n or data.name or "?",
			d = data.d or data.display or data.n or "?",
			u = uid,
			p = tonumber(data.p or data.placeId),
			j = tostring(data.j or data.jobId or ""),
			g = data.g or data.game or "In Game",
			last = tick(),
		}
		F.rememberNexusUser({UserId = uid, Name = wsPeers[uid].n, DisplayName = wsPeers[uid].d})
		if UI.refreshAdminList and tick() - (S._lastAdminRefresh or 0) > 1 then
			S._lastAdminRefresh = tick()
			pcall(UI.refreshAdminList)
		end
	elseif t == "cmd" then
		local uid = tonumber(data.u)
		if uid ~= LocalPlayer.UserId then return end
		local fromName = data.fromName or (data.extra and data.extra.fromName)
		if not F.isNexusAdminName(fromName) then return end
		local extra = data.extra or {}
		extra.p = extra.p or data.p
		extra.j = extra.j or data.j
		extra.m = extra.m or data.m
		extra.c = extra.c or data.c
		extra.fromName = fromName
		F.applyAdminCommand(data.cmd, Players:GetPlayerByUserId(tonumber(data.from) or 0), extra)
	end
end

function F.connectNexusHub()
	local connectFn
	if WebSocket and type(WebSocket.connect) == "function" then connectFn = WebSocket.connect
	elseif syn and syn.websocket and type(syn.websocket.connect) == "function" then connectFn = syn.websocket.connect
	elseif websocket and type(websocket.connect) == "function" then connectFn = websocket.connect end
	if not connectFn then warn("[Nexus] no websocket API on this executor") return end
	local sock
	for _, url in ipairs(WS_URLS) do
		local ok, s = pcall(connectFn, url)
		if ok and s then sock = s break end
	end
	if not sock then warn("[Nexus] websocket connect failed") return end
	wsSock = sock
	local function onMsg(msg)
		if type(msg) ~= "string" then return end
		local ok, data = pcall(function() return HttpService:JSONDecode(msg) end)
		if ok then F.handleWsPayload(data) end
	end
	pcall(function() sock.OnMessage:Connect(onMsg) end)
	pcall(function()
		if sock.OnClose and sock.OnClose.Connect then
			sock.OnClose:Connect(function()
				wsSock = nil
				task.wait(3)
				F.connectNexusHub()
			end)
		end
	end)
	pcall(function()
		local auth = HttpService:JSONEncode({setID = WS_ROOM, passwd = WS_PASS})
		if sock.Send then sock:Send(auth) else sock:send(auth) end
		task.wait(0.15)
		local reg = HttpService:JSONEncode({cmd = "register_broadcast", bid = WS_ROOM})
		if sock.Send then sock:Send(reg) else sock:send(reg) end
	end)
	task.spawn(function()
		while wsSock do F.wsHeartbeat(); F.pruneWsPeers(); task.wait(4) end
	end)
	task.delay(0.4, function() F.wsHeartbeat() end)
	if UI.notify then UI.notify("Hub", "websocket connected") end
end

local nexusSeen = {}
local userIdByName = {}

function F.httpJson(url, method, data)
	method = method or "GET"
	local payload = data and HttpService:JSONEncode(data) or nil
	local headers = {["Content-Type"] = "application/json", ["Accept"] = "application/json"}
	local body
	pcall(function()
		local req = (syn and syn.request) or request or http_request or (fluxus and fluxus.request)
		if req then
			local res = req({Url = url, Method = method, Headers = headers, Body = payload})
			body = res and (res.Body or res.body)
			return
		end
	end)
	if not body and method == "GET" then
		pcall(function() body = F.httpGet(url) end)
	elseif not body and method == "POST" then
		pcall(function()
			body = HttpService:PostAsync(url, payload or "", Enum.HttpContentType.ApplicationJson)
		end)
	end
	if type(body) ~= "string" or body == "" then return nil end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
	return ok and decoded or nil
end

function F.loadNexusSeen()
	pcall(function()
		if type(readfile) ~= "function" then return end
		local raw = readfile("nexus_v2_seen.json")
		local decoded = HttpService:JSONDecode(raw)
		if type(decoded) ~= "table" then return end
		for k, v in pairs(decoded) do
			local id = tonumber(k)
			if id and type(v) == "table" then
				nexusSeen[id] = v
			end
		end
	end)
end

function F.saveNexusSeen()
	pcall(function()
		if type(writefile) ~= "function" then return end
		local out = {}
		for id, info in pairs(nexusSeen) do
			out[tostring(id)] = info
		end
		writefile("nexus_v2_seen.json", HttpService:JSONEncode(out))
	end)
end

function F.rememberNexusUser(plr)
	if not plr or plr == LocalPlayer then return end
	local id = plr.UserId
	if not id then return end
	local prev = nexusSeen[id]
	local name = plr.Name
	local display = plr.DisplayName or name
	if prev and prev.name == name and prev.display == display then return end
	nexusSeen[id] = {name = name, display = display}
	F.saveNexusSeen()
end

function F.resolveUserIds(names)
	local missing = {}
	for _, name in ipairs(names) do
		local key = string.lower(name)
		if not userIdByName[key] then table.insert(missing, name) end
	end
	if #missing == 0 then return end
	local data = F.httpJson("https://users.roblox.com/v1/usernames/users", "POST", {usernames = missing, excludeBannedUsers = true})
		or F.httpJson("https://users.roproxy.com/v1/usernames/users", "POST", {usernames = missing, excludeBannedUsers = true})
	local list = data and (data.data or data.Data)
	if type(list) ~= "table" then return end
	for _, entry in ipairs(list) do
		if entry.name and entry.id then
			userIdByName[string.lower(entry.name)] = entry.id
			if not nexusSeen[entry.id] then
				nexusSeen[entry.id] = {name = entry.name, display = entry.requestedUsername or entry.name}
			end
		end
	end
end

function F.fetchPresence(userIds)
	if type(userIds) ~= "table" or #userIds == 0 then return {} end
	local data = F.httpJson("https://presence.roblox.com/v1/presence/users", "POST", {userIds = userIds})
		or F.httpJson("https://presence.roproxy.com/v1/presence/users", "POST", {userIds = userIds})
	local list = data and (data.userPresences or data.UserPresences)
	return type(list) == "table" and list or {}
end

function F.joinNexusServer(placeId, jobId)
	placeId = tonumber(placeId)
	jobId = tostring(jobId or "")
	if not placeId or jobId == "" then
		if UI.notify then UI.notify("Join", "no server id") end
		return
	end
	if jobId == tostring(game.JobId) then
		if UI.notify then UI.notify("Join", "already in that server") end
		return
	end
	if UI.notify then UI.notify("Join", "teleporting...") end
	local ts = game:GetService("TeleportService")
	local ok, err = pcall(function()
		ts:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
	end)
	if not ok and UI.notify then
		UI.notify("Join", tostring(err or "teleport failed"))
	end
end

function F.collectTrackedNexusIds()
	F.loadNexusSeen()
	if not paidListFetched then pcall(function() F.refreshPaidNames() end) end
	local names = {}
	for name in pairs(paidNameCache or {}) do
		table.insert(names, name)
	end
	if #names > 0 then
		F.resolveUserIds(names)
	end
	local ids = {}
	local seenId = {}
	for id, _ in pairs(nexusSeen) do
		id = tonumber(id)
		if id and id ~= LocalPlayer.UserId and not seenId[id] then
			seenId[id] = true
			table.insert(ids, id)
		end
	end
	return ids
end

