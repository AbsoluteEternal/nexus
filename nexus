	if not root or not goal then return end
	if S.tween then S.tween:Cancel(); S.tween = nil end
	local pos = goal.Position + Vector3.new(0, yOff, 0) + goal.RightVector * -leftOff
	goal = CFrame.new(pos, pos + root.CFrame.LookVector)
	S.tween = TweenService:Create(root, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = goal})
