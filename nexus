function F.showDamageNumber(plr, amount)
	if not S.dmgMarkers or amount <= 0 then return end
	local char = plr.Character
	if not char then return end
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not head then return end

	local function makeBillboard(totalText)
		local gui = Instance.new("BillboardGui")
		gui.Name = "NexusDmg"
		gui.AlwaysOnTop = true
		gui.Size = UDim2.new(0, 80, 0, 40)
		gui.StudsOffset = Vector3.new(-1.5, 2.8, 0)
		gui.Adornee = head
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Text = totalText
		label.TextColor3 = Theme.Accent
		label.Font = Enum.Font.GothamBold
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.new(0, 0, 0)

		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
		return gui, label
	end

	local cam = workspace.CurrentCamera
	local dist = cam and (cam.CFrame.Position - head.Position).Magnitude or 20
	local textSize = math.clamp(math.floor(10 + dist * 0.25 + 0.5), 11, 40)

	if S.dmgStack then
		local d = dmgStackData[plr]
		if d and d.gui and d.gui.Parent then
			d.total = d.total + amount
			d.label.Text = tostring(math.floor(d.total + 0.5))
			d.label.TextSize = textSize
			d.label.TextColor3 = Theme.Accent
			d.expire = tick() + 1.6
		else
			F.clearDmgStack(plr)
			local gui, label = makeBillboard(tostring(math.floor(amount + 0.5)))
			label.TextSize = textSize
			dmgStackData[plr] = {gui = gui, label = label, total = amount, expire = tick() + 1.6}
			task.spawn(function()
				while dmgStackData[plr] do
					local dd = dmgStackData[plr]
					if tick() >= dd.expire then F.clearDmgStack(plr) break end
					task.wait(0.1)
				end
			end)
		end
	else
		local gui, label = makeBillboard(tostring(math.floor(amount + 0.5)))
		label.TextSize = textSize
		task.delay(1.2, function()
			if gui and gui.Parent then
				TweenService:Create(label, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
				task.delay(0.3, function() pcall(function() gui:Destroy() end) end)
			end
		end)
	end
end

function F.watchHealth(plr)
	F.unwatchHealth(plr)
	local char = plr.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local lastHp = hum.Health
	local conn = hum.HealthChanged:Connect(function(newHp)
		local dropped = newHp < lastHp
		local delta = lastHp - newHp
		lastHp = newHp
		if not dropped then return end
		local att = S.lastHeadShot
		if att and att.plr == plr and (tick() - att.t) <= 0.75 then
			F.playHeadSound()
			S.lastHeadShot = nil
		end

		if S.dmgMarkers and plr ~= LocalPlayer and (tick() - (S.lastShotAt or 0)) <= 0.9 then
			F.showDamageNumber(plr, delta)
		end
	end)
	healthWatch[plr] = {hum = hum, conn = conn, lastHp = lastHp}
end

function F.setInvisible(on)
	S.invisible = on and true or false
	local char = LocalPlayer.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
			pcall(function()
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = on and 1 or 0
				elseif part:IsA("Decal") or part:IsA("Texture") then
					if on then
						if part:GetAttribute("NexusOldTrans") == nil then
							part:SetAttribute("NexusOldTrans", part.Transparency)
						end
						part.Transparency = 1
					else
						local old = part:GetAttribute("NexusOldTrans")
						part.Transparency = typeof(old) == "number" and old or 0
					end
				end
			end)
		end
		if part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
			pcall(function() part.Enabled = not on end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function() hum.NameDisplayDistance = on and 0 or 100 end)
	end
end

local xrayCache = {}
local xrayConn = nil
local XRAY_TRANS = 0.4

function F.isLocalCharPart(part)
	local char = LocalPlayer.Character
	return char and part:IsDescendantOf(char)
end

function F.applyXrayToPart(part)
	if not part:IsA("BasePart") then return end
	if F.isLocalCharPart(part) then return end
	if xrayCache[part] == nil then
		xrayCache[part] = part.Transparency
	end
	pcall(function() part.Transparency = XRAY_TRANS end)
end

function F.restoreXrayPart(part)
	local old = xrayCache[part]
	if old == nil then return end
	pcall(function()
		if part.Parent then part.Transparency = old end
	end)
	xrayCache[part] = nil
end

function F.setXray(on)
	S.xray = on and true or false
	if xrayConn then
		pcall(function() xrayConn:Disconnect() end)
		xrayConn = nil
	end
	if on then
		for _, inst in ipairs(workspace:GetDescendants()) do
			F.applyXrayToPart(inst)
		end
		xrayConn = workspace.DescendantAdded:Connect(function(inst)
			if not S.xray then return end
			task.defer(function() F.applyXrayToPart(inst) end)
		end)
	else
		for part in pairs(xrayCache) do
			F.restoreXrayPart(part)
		end
		table.clear(xrayCache)
	end
end

