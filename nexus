		end
	end
	if IS_MOBILE and UI.setFlyPadVisible then
		UI.setFlyPadVisible(S.fly == true)
	end
	if S.mobileKeys then
		for k in pairs(S.mobileKeys) do S.mobileKeys[k] = false end
	end
end

function F.startFreecam()
	if S.freecamConn then pcall(function() S.freecamConn:Disconnect() end); S.freecamConn = nil end
	S.freecam = true
	if S.fly then
		S.fly = false
		pcall(F.stopFly)
		if toggleSetters.Fly then pcall(function() toggleSetters.Fly(false) end) end
	end
	Camera.CameraType = Enum.CameraType.Scriptable
	local cf = Camera.CFrame
	S.freecamCF = cf
	local look = cf.LookVector
	S.freecamYaw = math.atan2(-look.X, -look.Z)
	S.freecamPitch = math.asin(math.clamp(look.Y, -1, 1))
	F.updateFreecamMouse()
	F.freezeCharacterForFreecam()

	if IS_MOBILE and UI.setFlyPadVisible then
		UI.setFlyPadVisible(true)
	end

	S.freecamConn = RunService.RenderStepped:Connect(function(dt)
		if not S.freecam then return end
		F.freezeCharacterForFreecam()
		F.updateFreecamMouse()

		local speed = (S.flySpeed or 50)
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 2 end
		local menuOpen = not S.minimized

		if not IS_MOBILE and not menuOpen then
			local d = UserInputService:GetMouseDelta()
			S.freecamYaw = S.freecamYaw - d.X * 0.004
			S.freecamPitch = math.clamp(S.freecamPitch - d.Y * 0.004, -1.4, 1.4)
		end

		local rot = CFrame.Angles(0, S.freecamYaw, 0) * CFrame.Angles(S.freecamPitch, 0, 0)
		local pos = (S.freecamCF and S.freecamCF.Position) or Camera.CFrame.Position
		local lookV = rot.LookVector
		local rightV = rot.RightVector
		local move = Vector3.zero
		local mk = S.mobileKeys or {}

		if UserInputService:IsKeyDown(Enum.KeyCode.W) or mk.W then move = move + lookV end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or mk.S then move = move - lookV end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or mk.A then move = move - rightV end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or mk.D then move = move + rightV end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) or mk.Up then
			move = move + Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or mk.Down then
			move = move - Vector3.yAxis
		end

		local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			local md = hum.MoveDirection
			if md.Magnitude > 0.05 then move = move + md end
		end

		if move.Magnitude > 0 then
			pos = pos + move.Unit * speed * dt
		end
		S.freecamCF = CFrame.new(pos) * rot
		Camera.CameraType = Enum.CameraType.Scriptable
		Camera.CFrame = S.freecamCF
	end)
end

function F.setFreecam(on)
	if on then F.startFreecam() else F.stopFreecam() end
end

function F.isAlive(plr)
	local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0
end

function F.nameMatchesFilter(plr)
	local filter = string.lower((S.aimName or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	if filter == "" then return true end
	local n = string.lower(plr.Name)
	local d = plr.DisplayName and string.lower(plr.DisplayName) or ""
	return n == filter or d == filter or string.find(n, filter, 1, true) or string.find(d, filter, 1, true)
end

function F.anyAimTeamSelected()
	local t = S.aimTeams
	return t and (t.Prisoners or t.Criminals or t.Police)
end

function F.matchesAimTarget(plr)
	local filter = string.lower((S.aimName or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	if filter ~= "" then return F.nameMatchesFilter(plr) end

	if not F.anyAimTeamSelected() then return true end
	if not plr.Team then return false end
	local name = plr.Team.Name
	local teams = S.aimTeams
	if teams.Prisoners and name == "Inmates" then return true end
	if teams.Criminals and name == "Criminals" then return true end
	if teams.Police and name == "Guards" then return true end
	return false
end

function F.isInFovCircle(pos)
	local sp, on = Camera:WorldToViewportPoint(pos)
	if not on or sp.Z < 0 then return false end

	return (Vector2.new(sp.X, sp.Y) - F.getMouseViewportPos()).Magnitude <= S.fovRadius
end

function F.hasLineOfSight(part)
	if not part then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if LocalPlayer.Character then
		table.insert(exclude, LocalPlayer.Character)
	end

	if part.Parent then
		table.insert(exclude, part.Parent)
	end
	params.FilterDescendantsInstances = exclude
	local origin = Camera.CFrame.Position
	local dir = part.Position - origin
	if dir.Magnitude < 0.5 then return true end
	local r = workspace:Raycast(origin, dir, params)

	return r == nil
end

function F.getPlayerDistance(plr)
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local theirRoot = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot or not theirRoot then return math.huge end
	return (theirRoot.Position - myRoot.Position).Magnitude
end

function F.getClosestPlayer(enemyOnly, requireFov, maxRange, skipLos)
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local best, bestD = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and F.isAlive(plr) then
			local head = plr.Character:FindFirstChild("Head")
			local ok = head ~= nil
			if ok and enemyOnly and not F.matchesAimTarget(plr) then ok = false end
			if ok and requireFov and not F.isInFovCircle(head.Position) then ok = false end
			if ok and not skipLos and requireFov and not F.hasLineOfSight(head) then ok = false end
			if ok then
				local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
				if not (maxRange and d > maxRange) then
					if d < bestD then bestD, best = d, plr end
				end
			end
		end
	end
	return best
end

function F.refreshTargetList()
	table.clear(targetList)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(targetList, plr)
		end
	end
	if S.targetIndex > #targetList then S.targetIndex = math.max(1, #targetList) end
end

function F.getAimPart(char)
	if not char then return end
	if not (IS_PAID and S.legit) then return char:FindFirstChild("Head") end
	if tick() - S.lastLegit >= LEGIT_INTERVAL then
		S.lastLegit = tick()
		local avail = {}
		for _, n in ipairs(LEGIT_PARTS) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then table.insert(avail, n) end
		end
		S.legitPart = #avail > 0 and avail[math.random(1, #avail)] or "Head"
	end
	local p = char:FindFirstChild(S.legitPart)
	return (p and p:IsA("BasePart") and p) or char:FindFirstChild("Head")
end

function F.hasTool(plr, kw)
	kw = string.lower(kw)
	local function chk(c)
		if not c then return false end
		for _, i in ipairs(c:GetChildren()) do
			if i:IsA("Tool") and string.find(string.lower(i.Name), kw) then return true end
		end
	end
	return chk(plr:FindFirstChild("Backpack")) or (plr.Character and chk(plr.Character))
end

function F.getESPColor(plr)
	if S.espTeamColors then
		if plr.Team then
			return plr.TeamColor.Color
		end

		local tn = plr.Team and plr.Team.Name or ""
		local lower = string.lower(tn)
		if string.find(lower, "guard") or string.find(lower, "police") then
			return Color3.fromRGB(50, 120, 255)
		elseif string.find(lower, "criminal") then
			return Color3.fromRGB(255, 60, 60)
		elseif string.find(lower, "inmate") or string.find(lower, "prison") then
			return Color3.fromRGB(255, 140, 40)
		end
		return Color3.fromRGB(200, 200, 200)
	end
	return Theme.Accent or Color3.fromRGB(90, 160, 255)
end

