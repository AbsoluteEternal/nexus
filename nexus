local noclipFrontParts = {}

function F.isFloorOrGround(part)
	if not part then return false end
	local n = string.lower(part.Name or "")
	return n == "floor" or n == "ground"
end

function F.restoreFrontNoclipParts()
	for part, orig in pairs(noclipFrontParts) do
		if part and part.Parent then
			pcall(function() part.CanCollide = orig end)
		end
		noclipFrontParts[part] = nil
	end
end

function F.tryFrontNoclip()
	if not S.worldNoclip then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	if not hum or not root then return end
	if hum.Sit or hum.SeatPart then
		F.restoreFrontNoclipParts()
		return
	end

	local look = root.CFrame.LookVector
	if look.Magnitude < 0.05 then
		F.restoreFrontNoclipParts()
		return
	end
	look = look.Unit

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {char}
	rayParams.IgnoreWater = true

	local seen = {}
	local origins = {
		root.Position,
		root.Position + root.CFrame.RightVector * 1.5,
		root.Position - root.CFrame.RightVector * 1.5,
		root.Position + Vector3.new(0, 1.5, 0),
	}
	for _, origin in ipairs(origins) do
		local hit = workspace:Raycast(origin, look * 8, rayParams)
		if hit and hit.Instance and hit.Instance:IsA("BasePart") then
			local part = hit.Instance
			seen[part] = true
			if noclipFrontParts[part] == nil then
				noclipFrontParts[part] = part.CanCollide
			end
			pcall(function() part.CanCollide = false end)
		end
	end
	for part, orig in pairs(noclipFrontParts) do
		if not seen[part] then
			if part and part.Parent then
				pcall(function() part.CanCollide = orig end)
			end
			noclipFrontParts[part] = nil
		end
	end
end

function F.setWorldNoclip(on)
	S.worldNoclip = on and true or false
	if S.worldNoclipConn then
		pcall(function() S.worldNoclipConn:Disconnect() end)
		S.worldNoclipConn = nil
	end
	if not on then
		F.restoreFrontNoclipParts()
		return
	end
	S.worldNoclipConn = RunService.Heartbeat:Connect(function()
		F.tryFrontNoclip()
	end)
end

function F.setDoors(on)
	S.doors = on
	if S.doorsConn then S.doorsConn:Disconnect(); S.doorsConn = nil end
	if on then
		for _, e in ipairs(doorCache) do
			if e.clone and e.clone.Parent then pcall(function() e.clone:Destroy() end) end
		end
		table.clear(doorCache)
		for _, name in ipairs({"CellDoors", "Doors"}) do
			local obj = workspace:FindFirstChild(name)
			if obj then
				local ok, cl = pcall(function() return obj:Clone() end)
				if ok and cl then table.insert(doorCache, {clone = cl, parent = obj.Parent}); obj:Destroy() end
			end
		end
		S.doorsConn = workspace.ChildAdded:Connect(function(ch)
			task.wait(0.05)
			if S.doors and (ch.Name == "CellDoors" or ch.Name == "Doors") then
				local ok, cl = pcall(function() return ch:Clone() end)
				if ok and cl then table.insert(doorCache, {clone = cl, parent = ch.Parent}); ch:Destroy() end
			end
		end)
	else
		for _, e in ipairs(doorCache) do
			if e.clone and e.parent then pcall(function() e.clone.Parent = e.parent end) end
		end
		table.clear(doorCache)
	end
end

function F.startFly()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local seat, vr, vm = hum.SeatPart, nil, nil
	if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
		vr = seat.AssemblyRootPart
		vm = seat:FindFirstAncestorOfClass("Model")
		if not vr and vm then vr = vm.PrimaryPart or vm:FindFirstChildWhichIsA("BasePart") end
	end
	S.flyTarget, S.vehicle = vr or root, vm
	hum.PlatformStand = true
	F.setNoclip(true)
	if S.noclipConn then S.noclipConn:Disconnect() end
	S.noclipConn = RunService.Stepped:Connect(function() if S.fly then F.setNoclip(true) end end)
	if S.bv then S.bv:Destroy() end
	if S.bg then S.bg:Destroy() end
	S.bv = Instance.new("BodyVelocity")
	S.bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	S.bv.Velocity = Vector3.zero
	S.bv.Parent = S.flyTarget
	S.bg = Instance.new("BodyGyro")
	S.bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	S.bg.P = 10000
	S.bg.Parent = S.flyTarget
	if S.flyConn then S.flyConn:Disconnect() end
	S.flyConn = RunService.RenderStepped:Connect(function()
		if not S.fly or not S.bv or not S.bg then return end
		local cf, dir = Camera.CFrame, Vector3.zero
		local mk = S.mobileKeys or {}
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or mk.W then dir = dir + cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or mk.S then dir = dir - cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or mk.A then dir = dir - cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or mk.D then dir = dir + cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or mk.Up then dir = dir + Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or mk.Down then
			dir = dir - Vector3.yAxis
		end
		if dir.Magnitude > 0 then dir = dir.Unit * S.flySpeed end
		S.bv.Velocity, S.bg.CFrame = dir, cf
	end)
