				if asz.X < 1 or asz.Y < 1 then return end
				s = math.clamp((m.X - ap.X) / asz.X, 0, 1)
				v = 1 - math.clamp((m.Y - ap.Y) / asz.Y, 0, 1)
				emit()
			end
