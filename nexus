			if key == Enum.KeyCode.Escape then
				local b = keybindButtons[S.listening]
				if b then b.Text = keycodeToString(keybinds[S.listening]); b.BackgroundColor3 = Theme.Element; b.TextColor3 = Theme.Accent end
				S.listening = nil
				return
			end
			keybinds[S.listening] = key
			local b = keybindButtons[S.listening]
			if b then b.Text = keycodeToString(key); b.BackgroundColor3 = Theme.Element; b.TextColor3 = Theme.Accent end
			S.listening = nil
			return
		end

		if input.KeyCode == Enum.KeyCode.Z and S.minimized then
			setMenuVisible(true)
			return
		end
		if gp then return end
		for bindKey, kc in pairs(keybinds) do
			if kc and input.KeyCode == kc then
				local setter = toggleSetters[bindKey]
				if setter then
					local cur = toggleStates[bindKey]
					if cur == nil then cur = false end
					setter(not cur)
					notify(bindKey, not cur)
				end
			end
		end
	end)

