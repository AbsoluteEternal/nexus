function F.httpGet(url)
	if syn and syn.request then return syn.request({Url=url,Method="GET"}).Body end
	if request then return request({Url=url,Method="GET"}).Body end
	if http_request then return http_request({Url=url,Method="GET"}).Body end
	if fluxus and fluxus.request then return fluxus.request({Url=url,Method="GET"}).Body end
	return game:HttpGet(url)
end

local paidNameCache = nil
local paidListFetched = false

function F.fetchPaidNames()
	local names = {}
	local body
	local url = PAID_LIST_URL .. "?t=" .. tostring(os.time())
	pcall(function()
		body = F.httpGet(url)
	end)
	if type(body) ~= "string" or body == "" then
		return names
	end
	body = body:gsub("^\239\187\191", "")
	if string.find(string.lower(body), "<html", 1, true) then
		return names
	end
	for line in string.gmatch(body, "[^\r\n]+") do
		local n = line:gsub("^\239\187\191", ""):gsub("%s+", "")
		if n ~= "" and not string.find(n, "^#") and not string.find(n, "<") then
			names[string.lower(n)] = true
		end
	end
	return names
end

function F.refreshPaidNames()
	paidNameCache = F.fetchPaidNames()
	paidListFetched = true
	return paidNameCache
end

function F.thisAccountIsPaid()
	if not paidListFetched then
		F.refreshPaidNames()
	end
	local username = string.lower(tostring(LocalPlayer.Name or ""))
	if username == "" then return false end
	return (paidNameCache or {})[username] == true
end

