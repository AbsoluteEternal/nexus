					if F.silentAimHasTarget() then return end
					return hooked(p12, p13)
				end)
			end)
			if hooked then old = hooked end
		end
		return function(p12, p13)
			if F.silentAimHasTarget() then return end
			return old(p12, p13)
		end
	end
	mod.createBullet = wrap(mod.createBullet)
	mod.createTaser = wrap(mod.createTaser)
	mod.createSniper = wrap(mod.createSniper)
