		local function countTeams()
			local inmates, criminals, guards = 0, 0, 0
			for _, plr in ipairs(Players:GetPlayers()) do
				local t = plr.Team and plr.Team.Name or ""
				if t == "Inmates" then inmates = inmates + 1
				elseif t == "Criminals" then criminals = criminals + 1
