function F.updateSilentAimHighlight()
	if not S.silentAim and not S.wallbang then F.clearSilentAimHighlight(); return end
	local maxR = (IS_PAID and S.silentRangeOn) and S.silentMaxRange or nil
	local target
	if S.wallbang then

		target = F.getWallbangTarget()
	else
		target = F.getClosestPlayer(true, true, maxR)
	end
	if not target or not target.Character or not F.isAlive(target) then F.clearSilentAimHighlight(); return end
	if S.silentTarget == target and S.silentHL and S.silentHL.Parent == target.Character then
		S.silentHL.FillColor = Theme.Accent
		S.silentHL.OutlineColor = Theme.Accent
		S.silentHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		S.silentHL.Enabled = true
		return
	end
	F.clearSilentAimHighlight()
	S.silentTarget = target
	local hl = Instance.new("Highlight")
	hl.Name = "NexusSilentAimTarget"
	hl.Adornee = target.Character
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillTransparency = 0.35
	hl.OutlineTransparency = 0
	hl.FillColor = Theme.Accent
	hl.OutlineColor = Theme.Accent
	hl.Enabled = true
	hl.Parent = target.Character
	S.silentHL = hl
end

function F.getSilentAimHitPart()
	if not S.silentAim then return nil end
	local plr = S.silentTarget
	if not plr or not plr.Parent then return nil end
	local char = plr.Character
	if not char or not F.isAlive(plr) or not F.matchesAimTarget(plr) then return nil end
	if IS_PAID and S.silentRangeOn and F.getPlayerDistance(plr) > (S.silentMaxRange or 1000) then return nil end
	local head = char:FindFirstChild("Head")
	if not head then return nil end

	if not F.isInFovCircle(head.Position) then return nil end

	if IS_PAID and S.legit then
		return F.getAimPart(char) or head
	end
	return head
end

function F.getTorsoPart(char)
	if not char then return nil end
	return char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("HumanoidRootPart")
end

function F.getWallbangTarget()
	local mouse = F.getMouseViewportPos()
	local best, bestD = nil, math.huge
	local maxR = (IS_PAID and S.silentRangeOn) and S.silentMaxRange or nil
	local needFov = S.fovCircle == true
	local radius = S.fovRadius or 120
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and F.isAlive(plr) and F.matchesAimTarget(plr) and plr.Character then
			local char = plr.Character
			local part = F.getTorsoPart(char) or char:FindFirstChild("Head")
			if part and not (maxR and F.getPlayerDistance(plr) > maxR) then
				local sp, on = Camera:WorldToViewportPoint(part.Position)
				if on and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
					if (not needFov) or d <= radius then
						if d < bestD then
							bestD = d
							best = plr
						end
					end
				end
			end
		end
	end
	return best
end

function F.getWallbangHitPart()
	if not S.wallbang then return nil end
	local plr = F.getWallbangTarget()
	if not plr then return nil end

	local named = Players:FindFirstChild(plr.Name)
	local char = (named and named.Character) or plr.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart") or F.getTorsoPart(char)
end

