local COUNTER_BASELINE = 150

function F.hitGlobalExecCounter()

	local key = tostring(COUNTER_NS) .. "_" .. tostring(COUNTER_KEY)
	local urls = {
		"https://countapi.mileshilliard.com/api/v1/hit/" .. key,
		"https://api.countapi.xyz/hit/" .. COUNTER_NS .. "/" .. COUNTER_KEY,
	}
	for _, url in ipairs(urls) do
		local ok, body = pcall(F.httpGet, url)
		if ok and body then
			local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
			if ok2 and type(data) == "table" then
				local n = tonumber(data.value or data.count or data.Count or data.Value)
				if n then return n + COUNTER_BASELINE end
			else
				local n = tonumber(body)
				if n then return n + COUNTER_BASELINE end
			end
		end
	end
	return COUNTER_BASELINE
end

