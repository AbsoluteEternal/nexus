local dmgStackData = {}
function F.clearDmgStack(plr)
	local d = dmgStackData[plr]
	if d then
		if d.gui then pcall(function() d.gui:Destroy() end) end
		if d.conn then pcall(function() d.conn:Disconnect() end) end
		dmgStackData[plr] = nil
	end
