local ARREST_RANGE = 100
local lastArrestAt = 0

function F.hasHandcuffsEquipped()
	local char = LocalPlayer.Character
	if not char then return false end
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") and string.find(string.lower(tool.Name), "handcuff", 1, true) then
			return true
		end
	end
	return false
end

function F.getArrestTarget()

	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local function inRange(plr)
		if not plr or plr == LocalPlayer or not plr.Parent then return false end
		if not F.isAlive(plr) then return false end
		local hr = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not hr then return false end
		return (hr.Position - root.Position).Magnitude <= ARREST_RANGE
	end
	if S.silentTarget and inRange(S.silentTarget) then return S.silentTarget end
	local best, bestD = nil, ARREST_RANGE
	for _, plr in ipairs(Players:GetPlayers()) do
		if inRange(plr) and F.matchesAimTarget(plr) then
			local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
			if d < bestD then bestD, best = d, plr end
		end
	end
	return best
end

function F.tryLongArrest()
	if not S.longArrest then return end
	if not F.hasHandcuffsEquipped() then return end
	if tick() - lastArrestAt < 0.35 then return end
	local target = F.getArrestTarget()
	if not target then return end
	lastArrestAt = tick()
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local remote = remotes and remotes:FindFirstChild("ArrestPlayer")
		if remote then

			if remote:IsA("RemoteFunction") then
				remote:InvokeServer(target, 1)
			elseif remote:IsA("RemoteEvent") then
				remote:FireServer(target, 1)
			end
		end
	end)
end

