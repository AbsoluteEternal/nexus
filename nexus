function F.grabFromGiver(itemName, offset, fixedPos)
	offset = offset or Vector3.new(0, 0, 3)
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local targetCF
	if fixedPos then
		targetCF = CFrame.new(fixedPos)
	else
		local giver = workspace:FindFirstChild("Prison_ITEMS") and workspace.Prison_ITEMS:FindFirstChild("giver")
		local item = giver and giver:FindFirstChild(itemName)
		if not item then return end
		local part = item:IsA("BasePart") and item or (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true))
		if not part then return end
		targetCF = part.CFrame * CFrame.new(offset)
	end
	if S.tween then S.tween:Cancel(); S.tween = nil end
	local orig = root.CFrame
	local to = TweenService:Create(root, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {CFrame = targetCF})
	S.tween = to; to:Play(); to.Completed:Wait(); S.tween = nil
	local function has()
		local function match(c)
			if not c then return false end
			if c:FindFirstChild(itemName) then return true end
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(itemName), 1, true) then return true end
			end
		end
		return match(LocalPlayer:FindFirstChild("Backpack")) or match(LocalPlayer.Character)
	end
	local t0 = tick()
	while not has() and tick() - t0 < 8 do
		if root.Parent then root.CFrame = targetCF end
		task.wait(0.05)
	end
	if root.Parent then
		local back = TweenService:Create(root, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {CFrame = orig})
		S.tween = back; back:Play(); back.Completed:Connect(function() S.tween = nil end)
	end
end

function F.clearSilentAimHighlight()
