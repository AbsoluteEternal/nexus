function F.firstWord(str)
	if type(str) ~= "string" or str == "" then return "" end
	return (str:match("^%s*(%S+)") or ""):lower()
end

function F.killfeedCollectText(entry)
	local candidates = { entry.Name }
	pcall(function()
		if entry:IsA("StringValue") then table.insert(candidates, entry.Value) end
		if entry:IsA("TextLabel") or entry:IsA("TextButton") or entry:IsA("TextBox") then
			table.insert(candidates, entry.Text)
		end
		for _, d in ipairs(entry:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				table.insert(candidates, d.Text)
			elseif d:IsA("StringValue") then
				table.insert(candidates, d.Value)
			end
		end
		for _, d in ipairs(entry:GetChildren()) do
			if d:IsA("StringValue") or d:IsA("ObjectValue") then
				table.insert(candidates, d.Name)
				if d:IsA("StringValue") then table.insert(candidates, d.Value) end
			end
		end
	end)
	return candidates
end

function F.killfeedEntryIsMine(entry)
	if not entry then return false end
	local myName = string.lower(LocalPlayer.Name)
	local myDisplay = LocalPlayer.DisplayName and string.lower(LocalPlayer.DisplayName) or ""
	for _, raw in ipairs(F.killfeedCollectText(entry)) do
		local fw = F.firstWord(raw)
		if fw ~= "" and (fw == myName or (myDisplay ~= "" and fw == myDisplay)) then
			return true
		end
	end
	return false
end

function F.cleanNameToken(name)
	if type(name) ~= "string" then return "" end
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	local beforeAt = name:match("^(.-)%s*%(@[^%)]+%)%s*$")
	if beforeAt and beforeAt ~= "" then
		name = beforeAt:gsub("%s+$", "")
	end
	name = name:gsub("@[%w_]+", "")
	name = name:gsub("[%(%)]", "")
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	return name
end

function F.findPlayerLoose(name)
	if type(name) ~= "string" or name == "" then return nil end
	local cleaned = F.cleanNameToken(name)
	local lower = string.lower(cleaned)
	local lowerRaw = string.lower(name)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == lower or string.lower(p.Name) == lowerRaw then return p end
		if p.DisplayName and (string.lower(p.DisplayName) == lower or string.lower(p.DisplayName) == lowerRaw) then
			return p
		end
	end
	local uname = name:match("%(@([%w_]+)%)") or name:match("@([%w_]+)")
	if uname then
		local ul = string.lower(uname)
		for _, p in ipairs(Players:GetPlayers()) do
			if string.lower(p.Name) == ul then return p end
		end
	end
	return nil
end

function F.resolveDisplayName(name)
	local plr = F.findPlayerLoose(name)
	if plr then
		local dn = plr.DisplayName
		if type(dn) == "string" and dn ~= "" then
			return dn
		end
		return plr.Name
	end
	local cleaned = F.cleanNameToken(name)
	return cleaned ~= "" and cleaned or "?"
end

function F.teamColorForName(name)
	local plr = F.findPlayerLoose(name)
	if plr and plr.Team then
		return plr.TeamColor.Color
	end
	return Color3.fromRGB(230, 230, 230)
end

function F.parseKillfeedEntry(entry)
	local killer, victim = nil, nil
	for _, raw in ipairs(F.killfeedCollectText(entry)) do
		if type(raw) == "string" and raw ~= "" then
			local a, b = raw:match("^%s*(.-)%s+[Kk]illed%s+(.-)%s+[Ww]ith%s+.+$")
			if a and b and a ~= "" and b ~= "" then
				killer, victim = a, b
				break
			end
			a, b = raw:match("^%s*(.-)%s+[Kk]illed%s+(.+)$")
			if a and b and a ~= "" and b ~= "" then
				b = b:gsub("%s+[Ww]ith%s+.+$", "")
				killer, victim = a, b
				break
			end
		end
	end
	if not killer then
		pcall(function()
			local k = entry:FindFirstChild("Killer") or entry:FindFirstChild("killer")
			local v = entry:FindFirstChild("Victim") or entry:FindFirstChild("victim")
				or entry:FindFirstChild("Killed") or entry:FindFirstChild("killed")
			if k then
				if k:IsA("ObjectValue") and k.Value and k.Value:IsA("Player") then
					killer = k.Value.Name
				elseif k:IsA("StringValue") and k.Value ~= "" then
					killer = k.Value
				end
			end
			if v then
				if v:IsA("ObjectValue") and v.Value and v.Value:IsA("Player") then
					victim = v.Value.Name
				elseif v:IsA("StringValue") and v.Value ~= "" then
					victim = v.Value
				end
			end
		end)
	end
	if killer then killer = killer:gsub("^%s+", ""):gsub("%s+$", "") end
	if victim then victim = victim:gsub("^%s+", ""):gsub("%s+$", "") end
	return killer, victim
end

